# Android (esqueleto, Etapa 1). Este arquivo unico cria os demais arquivos do app, compila o APK
# e grava os arquivos criados na propria branch. Roda na branch "android" ou manualmente.
name: Android

on:
  push:
    branches: [android]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Criar arquivos do app Android
        run: |
          mkdir -p "$(dirname android/settings.gradle.kts)"
          cat > android/settings.gradle.kts <<'EOF_FILE'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "SaintSeiyaAndroid"
          include(":app")
          EOF_FILE
          mkdir -p "$(dirname android/build.gradle.kts)"
          cat > android/build.gradle.kts <<'EOF_FILE'
          plugins {
              id("com.android.application") version "8.5.2" apply false
              id("org.jetbrains.kotlin.android") version "1.9.24" apply false
          }
          EOF_FILE
          mkdir -p "$(dirname android/gradle.properties)"
          cat > android/gradle.properties <<'EOF_FILE'
          org.gradle.jvmargs=-Xmx3g
          android.useAndroidX=true
          EOF_FILE
          mkdir -p "$(dirname android/app/build.gradle.kts)"
          cat > android/app/build.gradle.kts <<'EOF_FILE'
          plugins {
              id("com.android.application")
              id("org.jetbrains.kotlin.android")
          }

          android {
              namespace = "com.luizdan.sstheh"
              compileSdk = 34

              defaultConfig {
                  applicationId = "com.luizdan.sstheh"
                  minSdk = 29
                  targetSdk = 34
                  versionCode = 1
                  versionName = "0.0.1-esqueleto"
                  ndk { abiFilters += listOf("arm64-v8a") }
                  externalNativeBuild {
                      cmake {
                          arguments += listOf(
                              "-DANDROID_STL=c++_shared",
                              "-DSDL_DIR=${rootProject.projectDir}/third_party/SDL"
                          )
                      }
                  }
              }

              externalNativeBuild {
                  cmake {
                      path = file("src/main/cpp/CMakeLists.txt")
                  }
              }

              compileOptions {
                  sourceCompatibility = JavaVersion.VERSION_17
                  targetCompatibility = JavaVersion.VERSION_17
              }
              kotlinOptions { jvmTarget = "17" }
          }
          EOF_FILE
          mkdir -p "$(dirname android/app/src/main/AndroidManifest.xml)"
          cat > android/app/src/main/AndroidManifest.xml <<'EOF_FILE'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">

              <uses-feature android:glEsVersion="0x00030000" android:required="true" />
              <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />

              <application
                  android:label="Saint Seiya (port)"
                  android:allowBackup="false"
                  android:hasCode="true">
                  <activity
                      android:name=".GameActivity"
                      android:exported="true"
                      android:screenOrientation="sensorLandscape"
                      android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density"
                      android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF_FILE
          mkdir -p "$(dirname android/app/src/main/java/com/luizdan/sstheh/GameActivity.kt)"
          cat > android/app/src/main/java/com/luizdan/sstheh/GameActivity.kt <<'EOF_FILE'
          package com.luizdan.sstheh

          import org.libsdl.app.SDLActivity

          /** A atividade do jogo: a do SDL3, que carrega libSDL3.so e libmain.so e chama SDL_main. */
          class GameActivity : SDLActivity() {
              override fun getLibraries(): Array<String> = arrayOf("SDL3", "main")
          }
          EOF_FILE
          mkdir -p "$(dirname android/app/src/main/cpp/CMakeLists.txt)"
          cat > android/app/src/main/cpp/CMakeLists.txt <<'EOF_FILE'
          cmake_minimum_required(VERSION 3.22)
          project(sstheh_android C)

          # SDL3 compilado junto, como biblioteca compartilhada (libSDL3.so)
          set(SDL_SHARED ON CACHE BOOL "" FORCE)
          set(SDL_STATIC OFF CACHE BOOL "" FORCE)
          set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
          add_subdirectory(${SDL_DIR} SDL3-build)

          # libmain.so: o ponto de entrada (SDL_main). Na Etapa 3 ele passa a conter o motor.
          add_library(main SHARED skeleton_main.c)
          target_link_libraries(main PRIVATE SDL3::SDL3 log)
          EOF_FILE
          mkdir -p "$(dirname android/app/src/main/cpp/skeleton_main.c)"
          cat > android/app/src/main/cpp/skeleton_main.c <<'EOF_FILE'
          /* Esqueleto: prova que SDL3 inicia no Android e que o dispositivo grafico (Vulkan) abre.
           * O resultado aparece no logcat (tag "sstheh") e na tela (cor de fundo azul = tudo certo). */
          #define SDL_MAIN_USE_CALLBACKS 0
          #include <SDL3/SDL.h>
          #include <SDL3/SDL_main.h>
          #include <android/log.h>

          #define LOG(...) __android_log_print(ANDROID_LOG_INFO, "sstheh", __VA_ARGS__)

          int main(int argc, char **argv) {
              (void)argc; (void)argv;
              if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO | SDL_INIT_GAMEPAD)) {
                  LOG("SDL_Init falhou: %s", SDL_GetError());
                  return 1;
              }
              LOG("SDL %d iniciado", SDL_GetVersion());

              SDL_Window *win = SDL_CreateWindow("sstheh", 0, 0, SDL_WINDOW_FULLSCREEN);
              if (!win) { LOG("janela falhou: %s", SDL_GetError()); return 1; }

              SDL_GPUDevice *dev = SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_SPIRV, false, NULL);
              if (dev) {
                  LOG("SDL GPU ok, driver: %s", SDL_GetGPUDeviceDriver(dev));
                  SDL_ClaimWindowForGPUDevice(dev, win);
              } else {
                  LOG("SDL GPU falhou: %s", SDL_GetError());
              }

              for (int run = 1; run;) {
                  SDL_Event e;
                  while (SDL_PollEvent(&e)) if (e.type == SDL_EVENT_QUIT) run = 0;
                  if (dev) {
                      SDL_GPUCommandBuffer *cb = SDL_AcquireGPUCommandBuffer(dev);
                      SDL_GPUTexture *tex = NULL;
                      if (cb && SDL_WaitAndAcquireGPUSwapchainTexture(cb, win, &tex, NULL, NULL) && tex) {
                          SDL_GPUColorTargetInfo ct = {0};
                          ct.texture = tex;
                          ct.clear_color = (SDL_FColor){0.1f, 0.3f, 0.8f, 1.0f};
                          ct.load_op = SDL_GPU_LOADOP_CLEAR;
                          ct.store_op = SDL_GPU_STOREOP_STORE;
                          SDL_GPURenderPass *rp = SDL_BeginGPURenderPass(cb, &ct, 1, NULL);
                          SDL_EndGPURenderPass(rp);
                      }
                      if (cb) SDL_SubmitGPUCommandBuffer(cb);
                  } else {
                      SDL_Delay(16);
                  }
              }
              SDL_Quit();
              return 0;
          }
          EOF_FILE
          printf 'third_party/\napp/src/main/java/org/libsdl/\napp/build/\n.gradle/\nbuild/\n' > android/.gitignore

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: SDL3 (codigo-fonte e parte Java)
        run: |
          git clone --depth 1 --branch release-3.2.x https://github.com/libsdl-org/SDL.git android/third_party/SDL
          mkdir -p android/app/src/main/java/org/libsdl
          cp -r android/third_party/SDL/android-project/app/src/main/java/org/libsdl/app android/app/src/main/java/org/libsdl/
          git -C android/third_party/SDL rev-parse HEAD

      - name: Compilar APK (debug)
        working-directory: android
        run: gradle --no-daemon assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: sstheh-android-debug
          path: android/app/build/outputs/apk/debug/*.apk

      - name: Gravar os arquivos criados na branch
        if: success()
        run: |
          git config user.name "github-actions"
          git config user.email "actions@users.noreply.github.com"
          git add android
          git diff --cached --quiet || git commit -m "Android: esqueleto gerado pelo workflow"
          git push || true
